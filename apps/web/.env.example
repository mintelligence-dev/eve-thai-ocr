# Vercel AI Gateway key. On Vercel you can skip this and use OIDC instead
# (run `vercel env pull` locally). https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional. Any vision-capable "provider/model" available in AI Gateway.
RECEIPT_MODEL=google/gemini-2.5-flash

# Optional. In-app limits (best-effort, per server instance). Defaults shown.
RATE_LIMIT_PER_HOUR=10   # requests per visitor IP per hour
RATE_LIMIT_PER_DAY=200   # requests for the whole site per day
