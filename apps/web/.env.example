# Vercel AI Gateway key. On Vercel you can skip this and use OIDC instead
# (run `vercel env pull` locally). https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional. Any vision-capable "provider/model" available in AI Gateway.
RECEIPT_MODEL=google/gemini-2.5-flash

# Optional. In-app limits (best-effort, per server instance). Defaults shown.
RATE_LIMIT_PER_HOUR=10   # requests per visitor IP per hour
RATE_LIMIT_PER_DAY=200   # requests for the whole site per day

# Optional. Lets people check a transfer slip with the bank (see README, "Checking a
# slip with the bank"). Off unless both are set. Only the text of the slip's QR code is
# sent to the service, never the image. The service charges for its use.
SLIP_VERIFY_PROVIDER=    # easyslip, slipok or slip2go
SLIP_VERIFY_API_KEY=     # slip2go: the shop's Secret Key
SLIP_VERIFY_BRANCH_ID=    # slipok only: the branch the key belongs to
SLIP_RATE_LIMIT_PER_HOUR=20   # bank checks per visitor IP per hour
