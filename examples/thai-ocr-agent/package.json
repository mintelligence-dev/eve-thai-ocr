{
  "name": "thai-ocr-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Example app for @eve-thai-ocr: the web demo (upload, review, export) and an eve agent that mounts @eve-thai-ocr/eve, in one Next.js project.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @eve-thai-ocr/extractor build && pnpm --filter @eve-thai-ocr/eve build",
    "dev": "next dev",
    "prebuild": "pnpm --filter @eve-thai-ocr/extractor build && pnpm --filter @eve-thai-ocr/eve build",
    "build": "next build",
    "start": "next start",
    "dev:eve": "eve dev",
    "build:eve": "eve build",
    "eval": "eve eval",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eve-thai-ocr/eve": "workspace:*",
    "@eve-thai-ocr/extractor": "workspace:*",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.5",
    "ai": "^7.0.183",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eve": "1.4.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.82.0",
    "next": "^16.4.6",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
