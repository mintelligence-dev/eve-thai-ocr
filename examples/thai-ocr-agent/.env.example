# Copy to .env.local for `eve dev`. Never commit .env.local.

# Vercel AI Gateway key. Not needed on Vercel (the deployment's OIDC token is used),
# or locally after `vercel link` + `vercel env pull`. https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional. The agent's own model; it sees the attached photos, so use a vision model.
AI_MODEL=google/gemini-2.5-flash

# Optional. The model the extension reads documents with. Default: google/gemini-2.5-flash.
RECEIPT_MODEL=
