# Copy to .env.local. Never commit .env.local.

# Vercel AI Gateway key. Not needed on Vercel, where the deployment's OIDC token is used,
# or locally after `vercel link` + `vercel env pull`. https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional. The model that reads documents, for the web demo and the eve extension.
# Any vision-capable "provider/model" available in AI Gateway.
RECEIPT_MODEL=google/gemini-2.5-flash

# Optional. The eve agent's own model. It sees attached photos, so use a vision model.
AI_MODEL=google/gemini-2.5-flash

# Optional. Web demo limits (best-effort, per server instance). Defaults shown.
RATE_LIMIT_PER_HOUR=10   # requests per visitor IP per hour
RATE_LIMIT_PER_DAY=200   # requests for the whole site per day

# Optional. Lets people check a transfer slip with the bank in the web demo (see README,
# "Checking a slip with the bank"). Off unless both are set. Only the text of the slip's QR
# code is sent to the service, never the image. The service charges for its use.
SLIP_VERIFY_PROVIDER=    # easyslip, slipok or slip2go
SLIP_VERIFY_API_KEY=     # slip2go: the shop's Secret Key
SLIP_VERIFY_BRANCH_ID=    # slipok only: the branch the key belongs to
SLIP_RATE_LIMIT_PER_HOUR=20   # bank checks per visitor IP per hour
# Development only: keep confirmed bank answers in this folder and give them again, so testing
# does not spend the service's quota. The files hold names, so use a folder git ignores, such as
# an absolute path to bench/private/slip-answers.
SLIP_VERIFY_CACHE_DIR=
